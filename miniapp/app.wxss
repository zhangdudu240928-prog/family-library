/* 全局样式 */
page {
  background-color: #FAF6EF;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #3D2B1F;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* ── 颜色变量（通过类实现）─────────────────── */
/* 主色 brown */
.color-brown       { color: #3D2B1F; }
.color-brown-mid   { color: #6B4F3A; }
.color-brown-light { color: #9E8B7A; }
.color-muted       { color: #B8A99A; }
.color-jiejie      { color: #7DB5A0; }
.color-didi        { color: #E8956D; }

/* ── 通用容器 ─────────────────────────────── */
.container {
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

/* ── 卡片 ─────────────────────────────────── */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(61, 43, 31, 0.06);
}

/* ── Section 标题 ────────────────────────── */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D2B1F;
  margin-bottom: 6rpx;
}
.section-sub {
  font-size: 24rpx;
  color: #B8A99A;
}
.section-hd {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

/* ── 按钮 ─────────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  padding: 16rpx 32rpx;
  border: none;
  box-sizing: border-box;
}
.btn::after { border: none; }

.btn-primary {
  background: #3D2B1F;
  color: #FAF6EF;
}
.btn-outline {
  background: transparent;
  color: #3D2B1F;
  border: 1rpx solid #D4C9BF;
}
.btn-ghost {
  background: transparent;
  color: #9E8B7A;
}
.btn-danger {
  background: #C05050;
  color: #fff;
}
.btn-green {
  background: #7DB5A0;
  color: #fff;
}
.btn-sm {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 10rpx;
}
.btn-block {
  width: 100%;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
}

/* ── 书籍封面小色块 ──────────────────────── */
.book-spine {
  width: 10rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

/* ── 状态徽标 ─────────────────────────────── */
.status-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.status-available { background: #EDF7F4; color: #5F9E8C; }
.status-reading   { background: #FFF3E4; color: #D4852A; }
.status-read      { background: #F0EDF8; color: #7B66A0; }

/* ── 标签 ─────────────────────────────────── */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: #F5EFE8;
  color: #9E8B7A;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

/* ── 空状态 ──────────────────────────────── */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}
.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}
.empty-title {
  font-size: 30rpx;
  color: #9E8B7A;
  font-weight: 500;
  margin-bottom: 8rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: #B8A99A;
  text-align: center;
  line-height: 1.6;
}

/* ── 分割线 ──────────────────────────────── */
.divider {
  height: 1rpx;
  background: #EDE8E3;
  margin: 20rpx 0;
}

/* ── Toast（用 wx.showToast 代替，以下备用）── */
.toast-success { color: #5F9E8C; }
.toast-error   { color: #C05050; }

/* ── 底部安全区占位（避免被 tabBar 遮挡）─── */
.bottom-safe {
  height: 200rpx;
  flex-shrink: 0;
}

/* ── 书籍网格卡片 ─────────────────────────── */
.books-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.book-card {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(61,43,31,0.07);
}
.book-cover-area {
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
}
.book-cover-inner {
  width: 80rpx;
  height: 120rpx;
  border-radius: 4rpx 10rpx 10rpx 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.9);
  font-size: 18rpx;
  text-align: center;
  padding: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
  line-height: 1.3;
  word-break: break-all;
}
.book-card-info {
  padding: 12rpx 20rpx 20rpx;
}
.book-card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #3D2B1F;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.book-card-author {
  font-size: 22rpx;
  color: #9E8B7A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 书籍列表行 ─────────────────────────────── */
.book-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0EBE4;
}
.book-row:last-child { border-bottom: none; }
.book-row-info {
  flex: 1;
  min-width: 0;
}
.book-row-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #3D2B1F;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.book-row-meta {
  font-size: 22rpx;
  color: #9E8B7A;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 阅读记录条目 ─────────────────────────── */
.log-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0EBE4;
}
.log-item:last-child { border-bottom: none; }
.log-reader-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
.log-content { flex: 1; min-width: 0; }
.log-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #3D2B1F;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.log-meta {
  font-size: 22rpx;
  color: #9E8B7A;
  margin-top: 4rpx;
}
.log-note {
  font-size: 24rpx;
  color: #B8A99A;
  font-style: italic;
  margin-top: 6rpx;
  line-height: 1.5;
}

/* ── 星评 ──────────────────────────────────── */
.stars {
  font-size: 24rpx;
  color: #D4A853;
  margin-top: 6rpx;
  letter-spacing: 2rpx;
}
