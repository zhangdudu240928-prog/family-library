/* 阅读记录 */

.logs-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

/* 弹层 */
.overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(30, 20, 12, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}
.overlay.open {
  opacity: 1;
  pointer-events: auto;
}
.modal {
  background: #FAF6EF;
  border-radius: 32rpx 32rpx 0 0;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 32rpx 32rpx 60rpx;
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(.25,.8,.25,1);
}
.overlay.open .modal {
  transform: translateY(0);
}
.modal-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D2B1F;
}
.modal-close {
  font-size: 32rpx;
  color: #9E8B7A;
  padding: 8rpx;
}
.modal-ft {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.modal-ft .btn { flex: 1; }

/* 表单 */
.form-group { margin-bottom: 28rpx; }
.form-row { display: flex; gap: 20rpx; }
.form-group.half { flex: 1; min-width: 0; }
.form-label {
  font-size: 24rpx;
  color: #9E8B7A;
  margin-bottom: 10rpx;
  font-weight: 500;
}
.form-picker {
  height: 72rpx;
  line-height: 72rpx;
  background: #F8F4EF;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #3D2B1F;
  border: 1rpx solid #EDE8E3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.form-textarea {
  width: 100%;
  min-height: 120rpx;
  background: #F8F4EF;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #3D2B1F;
  box-sizing: border-box;
  border: 1rpx solid #EDE8E3;
  line-height: 1.7;
}
.btn.disabled { opacity: 0.6; }
